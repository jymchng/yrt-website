# Yishun River Trading — environment variables.
# Copy to .env.local and fill in. No real values belong in this file.
#
# The contact form is env-gated: when RESEND_API_KEY, CONTACT_TO_EMAIL and
# CONTACT_FROM_EMAIL are all present the server action attempts delivery and
# reports `delivered`; when any is missing it renders the `not-configured`
# state naming the missing variables and states that nothing was sent.

RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: canonical origin used for metadata, sitemap and OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
